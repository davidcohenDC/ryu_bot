# Copy this file to .env and fill in real values before running the bot.

# --- core --------------------------------------------------------------
TOKEN=your-discord-bot-token
PREFIX=!
INVITE_LINK=

# --- database ------------------------------------------------------------
SQL_DB_URI=sqlite+aiosqlite:///src/database/database.db
SQL_ECHO=false

# --- channel / role permissions -----------------------------------------
ALLOWED_CHANNELS=
ALLOWED_CHANNELS_ID=
ALLOWED_ROLES=
ALLOWED_ROLES_ID=

# --- tournament code channel ----------------------------------------------
CODE_CHANNEL_ID=0
CODE_GENERATION_CHANNEL=
CODE_GENERATION_CHANNEL_ID=

# --- rule-reaction role assignment ----------------------------------------
RULE_REACTION_ID=
RULE_REACTION_TARGET_EMOJI=

# --- roles -----------------------------------------------------------------
OWNER_ROLE=Owner
OWNER_ROLE_ID=0
RYUZEN_TEAM_ROLE=Team
RYUZEN_TEAM_ROLE_ID=0
TOURNAMENT_WINNER_ROLE=Winner
TOURNAMENT_WINNER_ROLE_ID=0

# --- staff / command channels ---------------------------------------------
STAFF_ROLE_IDS=
COMMAND_CHANNEL_IDS=

# --- reaction-role message -------------------------------------------------
RR_MESSAGE_ID=0
RR_EMOJI_NAMES=

# --- misc --------------------------------------------------------------
DEBUG_REACTIONS=false
